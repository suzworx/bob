# GitHub Actions secrets and variables (Settings -> Secrets and variables ->
# Actions). Every name here is read by .github/workflows/*.yml as secrets.NAME
# or vars.NAME; scripts/env-files.test.ts fails when this file and the
# workflows disagree. GITHUB_TOKEN is minted for every run by GitHub, so it is
# not listed. The test, typecheck and local-Supabase jobs need no secrets.
#
# Apply:  cp .env.github.example .env.github   (git-ignored), fill it in, then
#   gh secret set -f .env.github --repo <owner>/<repo>
# gh sets every line it finds, so delete a line you are not changing instead of
# leaving it empty. Quote a value that has spaces or <>.

# OTA firmware signing key (PEM, ECDSA P-256) for the release job. Generate:
# node scripts/release/fw-keys.mjs gen --id fw-2026a --out-dir <dir>, then
# gh secret set BOB_FW_SIGNING_KEY < <dir>/fw-2026a.key.pem
BOB_FW_SIGNING_KEY=
