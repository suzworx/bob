exports[`timer voice tools > returns the set, list and cancel result objects 1`] = `
{
  "cancelAll": {
    "message": "Cancelled 2 timers and alarms.",
    "ok": true,
  },
  "cancelByLabel": {
    "message": "Pasta timer cancelled.",
    "ok": true,
  },
  "cancelNone": {
    "message": "No timers are running.",
    "ok": true,
  },
  "cancelUnknown": {
    "message": "I couldn't find that timer.",
    "ok": true,
  },
  "cancelWhichOne": {
    "message": "Which one? You have 3 running.",
    "ok": true,
  },
  "list": {
    "message": "Timer: 1 minute 30 seconds left. Pasta timer: 10 minutes left. Wake up alarm at 1:30 PM.",
    "ok": true,
  },
  "listAfter": {
    "message": "No timers or alarms are set.",
    "ok": true,
  },
  "listEmpty": {
    "message": "No timers or alarms are set.",
    "ok": true,
  },
  "setAlarm": {
    "id": "<uuid-3>",
    "message": "Wake up alarm set for 1:30 PM.",
    "ok": true,
  },
  "setAlarmPast": {
    "ok": false,
    "reason": "that time has already passed",
  },
  "setTimer": {
    "id": "<uuid-1>",
    "message": "Pasta timer set for 10 minutes.",
    "ok": true,
  },
  "setTimerSeconds": {
    "id": "<uuid-2>",
    "message": "Timer set for 1 minute 30 seconds.",
    "ok": true,
  },
  "setTimerTooLong": {
    "ok": false,
    "reason": "timer duration must be between 1 second and 24 hours",
  },
  "setTimerUnreadable": {
    "ok": false,
    "reason": "unreadable duration",
  },
}
`;

exports[`timers HTTP > cancels one timer, then answers 404 for it, a fired one and a cancelled one 1`] = `
{
  "cancelAgain": {
    "body": {
      "error": {
        "code": "not_found",
      },
    },
    "status": 404,
  },
  "cancelCancelled": {
    "body": {
      "error": {
        "code": "not_found",
      },
    },
    "status": 404,
  },
  "cancelFired": {
    "body": {
      "error": {
        "code": "not_found",
      },
    },
    "status": 404,
  },
  "cancelMalformed": {
    "body": {
      "error": {
        "code": "invalid_request",
      },
    },
    "status": 400,
  },
  "cancelPending": {
    "body": {
      "cancelled": {
        "fire_at": "<epoch-ms>",
