        "remaining_ms": 600000,
        "zone": "UTC",
      },
      "remaining": 1,
    },
    "status": 200,
  },
  "cancelUnknown": {
    "body": {
      "error": {
        "code": "not_found",
      },
    },
    "status": 404,
  },
  "listAfter": {
    "body": {
      "timers": [
        {
          "fire_at": "<epoch-ms>",
          "id": "<uuid-2>",
          "kind": "alarm",
          "label": "wake up",
          "remaining_ms": 3600000,
          "zone": "UTC",
        },
      ],
    },
    "status": 200,
  },
}
`;

