{
  "name": "@bob/ui-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-vad-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "ui:mobile-sweep": "tsx scripts/mobile-sweep.ts",
    "icons": "sh scripts/icons.sh",
    "astryx": "node ../../node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@astryxdesign/core": "0.6.2",
    "@astryxdesign/theme-neutral": "0.6.2",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@openobserve/browser-logs": "0.4.3",
    "@openobserve/browser-rum": "0.4.3",
    "@ricky0123/vad-web": "0.0.31",
    "@stylexjs/stylex": "^0.19.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "ai": "^7.0.127",
    "html-to-image": "1.11.13",
    "katex": "^0.16.47",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "web-vitals": "6.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.2",
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "onnxruntime-web": "^1.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
