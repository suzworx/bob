{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://api.heybob.xyz/api/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/vad/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)\\.(js|mjs|css|map|png|jpg|jpeg|gif|webp|svg|ico|wasm|onnx|woff|woff2|json)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "installCommand": "cd ../.. && npm ci"
}
