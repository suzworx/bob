{
  "name": "bob",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, observable voice assistant",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev:all",
    "dev:api": "npm run dev --workspace @bob/api",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:offline": "node scripts/dev-offline.mjs",
    "run:dev": "npm run dev:all",
    "mdns": "node scripts/mdns.mjs",
    "dev:debug": "node scripts/dev-debug.mjs",
    "debug:tail": "node scripts/tee-log.mjs tail data/api-debug.log data/v2-debug.log",
    "debug": "npm run debug --workspace @bob/api",
    "start": "npm run start --workspace @bob/api",
    "build": "npm run typecheck && npm run device:compile",
    "check": "npm run check:boundaries && npm run check:quality && npm run check:ui-catalog && npm run check:ios-design && npm run typecheck && npm run test:unit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint:dead": "knip --no-progress",
    "check:docs": "node scripts/check-doc-paths.mjs",
    "check:ui-catalog": "node scripts/ui-catalog/check.mjs",
    "ui:mobile-sweep": "tsx apps/ui-v2/scripts/mobile-sweep.ts",
    "ui:catalog": "node scripts/ui-catalog/run.mjs",
    "ui:catalog:registry": "node scripts/ui-catalog/registry.mjs --write",
    "check:quality": "node scripts/check-quality.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "cleanup": "node scripts/cleanup.mjs",
    "logs:clean": "node scripts/clean-logs.mjs",
    "lint:migrations": "node scripts/migration-lint.mjs",
    "check:migration-order": "node scripts/migration-order.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:ios-design": "node scripts/check-ios-design.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:unit-gates": "node scripts/check-unit-gates.mjs",
    "check:marketing-pack": "node --import tsx scripts/check-marketing-pack.mjs",
    "gen:agents": "node scripts/gen-agents.mjs",
    "memory:backfill": "tsx apps/api/scripts/backfill-memory-embeddings.ts",
    "release:check": "node scripts/release-check.mjs",
    "validate": "node scripts/validate.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "validate:non-device": "node scripts/validate-non-device.mjs",
    "accept:replay": "tsx scripts/acceptance/replay.mjs",
    "memory:dupes": "tsx scripts/memory-dupes.ts",
    "memory:reconcile": "tsx scripts/memory-reconcile.ts",
    "validate:all": "npm run validate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:ai": "npm run typecheck --workspace @bob/ai",
    "typecheck:api": "npm run typecheck --workspace @bob/api",
    "test": "npm run typecheck",
    "test:unit": "npm test --workspace @bob/api",
    "test:all": "npm run validate -- --skip-firmware",
    "test:db": "vitest run --config apps/api/vitest.db.config.ts",
    "test:scenarios": "vitest run --config apps/api/vitest.scenarios.config.ts",
    "test:e2e": "npm run test:e2e --workspace @bob/ui-v2 --",
    "test:e2e:smoke": "npm run test:e2e:smoke --workspace @bob/ui-v2 --",
    "test:e2e:live": "tsx apps/ui-v2/e2e/run-live.ts",
    "test:watch": "vitest",
    "test:scripts": "vitest run scripts/ tools/",
    "test:live": "npm run test:live --workspace @bob/api",
    "eval": "tsx apps/ai/evals/advice.eval.ts && tsx apps/ai/evals/continuity.eval.ts && tsx apps/ai/evals/memory.eval.ts && tsx apps/ai/evals/quality.eval.ts && tsx apps/ai/evals/tools.eval.ts && tsx apps/ai/evals/voice-reply.eval.ts",
    "eval:local": "tsx apps/ai/evals/advice.eval.ts && tsx apps/ai/evals/continuity.eval.ts && tsx apps/ai/evals/memory.eval.ts && tsx apps/ai/evals/quality.eval.ts && tsx apps/ai/evals/tools.eval.ts && tsx apps/ai/evals/voice-reply.eval.ts",
    "eval:memory": "tsx apps/ai/evals/memory.eval.ts",
    "eval:helpfulness": "tsx apps/ai/evals/helpfulness.eval.ts",
    "eval:advice": "tsx apps/ai/evals/advice.eval.ts",
    "eval:tools": "tsx apps/ai/evals/tools.eval.ts",
    "eval:agents": "node scripts/eval-agents.mjs",
    "test:firmware": "npm run test:firmware --workspace @bob/cardputer --",
    "wire:emit": "npm run test:firmware --workspace @bob/cardputer -- --emit",
    "firmware:budget": "node scripts/firmware-budget.mjs --check",
    "device:compile": "npm run compile --workspace @bob/cardputer",
    "device:flash": "npm run flash --workspace @bob/cardputer --",
    "check:visor-path": "py -3.11 -I tools/bob-sim/visor-path-check.py",
    "visual:gate": "node tools/visual-gate/gate.mjs",
    "visual:golden": "node tools/visual-gate/golden.mjs",
    "device:monitor": "node scripts/tee-log.mjs tee data/device.log npm run monitor --workspace @bob/cardputer",
    "device:run": "npm run run --workspace @bob/cardputer",
    "device:test": "npm run test:device --workspace @bob/cardputer --",
    "device:integration-test": "npm run test:device --workspace @bob/cardputer --",
    "device:integration": "npm run test:device --workspace @bob/cardputer -- --server=real",
    "device:free-port": "npm run free-port --workspace @bob/cardputer",
    "turn:timeline": "node scripts/turn-timeline.mjs",
    "api:monitor": "node scripts/tee-log.mjs tail data/api.log data/v2-journal.log",
    "monitor": "node scripts/tee-log.mjs both data/device.log data/api.log data/v2-journal.log npm run monitor --workspace @bob/cardputer",
    "device:hil": "node scripts/hil/run.mjs",
    "device:hil:dry": "node scripts/hil/run.mjs --dry-run",
    "attest:device": "node scripts/device-attest.mjs",
    "attest": "node scripts/validate-attest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzworx/bob.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.1.2",
    "ai": "^7.0.127",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knip": "^6.38.0",
    "supabase": "2.117.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.3",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  }
}
