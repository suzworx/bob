# Golden-frame check: render one fixed scene twice in two fresh processes and require the PNGs
# to be byte-identical. Run by CTest as `cmake -DSIM=... -DSCENE=... -DOUT=... -P golden.cmake`.
if(SCENE STREQUAL "ready")
  set(ARGS --state ready --frames 20)
elseif(SCENE STREQUAL "listening")
  set(ARGS --state listening --frames 20)
elseif(SCENE STREQUAL "love")
  set(ARGS --state listening --emotion love --frames 20)
else()
  message(FATAL_ERROR "unknown scene ${SCENE}")
endif()

foreach(run a b)
  file(REMOVE_RECURSE ${OUT}/${SCENE}-${run})
  execute_process(COMMAND ${SIM} ${ARGS} --out ${OUT}/${SCENE}-${run} RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "bob-sim failed (${rc}) for ${SCENE}")
  endif()
endforeach()

file(GLOB frames RELATIVE ${OUT}/${SCENE}-a ${OUT}/${SCENE}-a/*.png)
list(LENGTH frames n)
if(n EQUAL 0)
  message(FATAL_ERROR "no PNG written for ${SCENE}")
endif()
foreach(f ${frames})
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/${SCENE}-a/${f} ${OUT}/${SCENE}-b/${f} RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "${SCENE}: ${f} differs between two renders")
  endif()
endforeach()
message(STATUS "${SCENE}: ${n} PNG(s) identical across two renders")
