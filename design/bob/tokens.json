{
  "$comment": "THE single source of truth for the Bob round UI (360x360 circle). Values were extracted from the owner-approved demo (docs/waveshare/device-ux-prototype.html). Never edit docs/waveshare/bob-tokens.{css,js} or libs/bob-device/src/bob_tokens.h or apps/cardputer/scripts/bob_tokens.json by hand: change this file and run `node design/bob/build.mjs`.",
  "version": 1,
  "palette": {
    "ink": "#173E57",
    "paper": "#FFFDF6",
    "yellow": "#F0C75E",
    "sky": "#BBDDF0",
    "grass": "#72965B",
    "coral": "#F07A6A",
    "dim": "#7F97A6",
    "chipDisc": "#0F2B3F",
    "chipStrip": "#2A5775",
    "visor": "#12151A"
  },
  "paletteNotes": {
    "chipDisc": "the status-arc disc: rgba(8,28,44,.55) composited on ink, as one opaque colour so web and device draw the same pixels",
    "chipStrip": "the shortcut-chip strip and the volume arc track (device)",
    "dim": "muted text and the off state of a glyph"
  },
  "typography": {
    "family": "Nunito",
    "fallback": "\"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif",
    "roles": {
      "caption": { "size": 15, "weight": 600, "name": "SemiBold" },
      "body": { "size": 17, "weight": 600, "name": "SemiBold", "renderWeight": 730, "note": "the browser draws weight 600 heavier than a plain coverage mask; the device font is built at renderWeight" },
      "title": { "size": 24, "weight": 800, "name": "ExtraBold" },
      "hero": { "size": 40, "weight": 800, "name": "ExtraBold" },
      "url": { "size": 14, "weight": 600, "name": "SemiBold" },
      "micro": { "size": 12, "weight": 600, "name": "SemiBold" },
      "code": { "size": 32, "weight": 800, "name": "ExtraBold" }
    }
  },
  "grid": {
    "size": 360,
    "center": 180,
    "radius": 180,
    "margin": 12,
    "bob": { "cx": 180, "cy": 195, "feetY": 298, "frameTop": 49, "frameH": 262, "clipTop": 54, "clipBottom": 312, "topGapMin": 6 },
    "bobNote": "Bob sits 40 px lower than the first demo (cy 185, feet 288) so the top button keeps topGapMin px clear of the status-icon discs (disc 32, arc radius 146, owner asked for larger icons 2026-10-21) at rest and at every move apex; the hop lifts him about 39 px. frameTop is the top row of his frame sprite (the accents are drawn in it); the clip starts at clipTop, under the discs. The caption stays at y 327; the small-Bob views (pairing, speaking, reply) scale about his feet, so their rise grew by the same amount and they sit where they did. The placement checker enforces the gap (top-gap).",
    "propSlots": { "left": [92, 96], "right": [268, 96] },
    "caption": { "y": 327, "role": "body" },
    "body": { "top": 56, "bottom": 300 }
  },
  "statusArc": {
    "radius": 142,
    "stepDeg": 18,
    "disc": { "diameter": 40, "color": "chipDisc" },
    "glyph": { "size": 24, "strokeWidth": 2.6 },
    "symmetry": "N icons at angles (i-(N-1)/2)*stepDeg about 12 o'clock, centre (grid.center, grid.center - radius*cos a)",
    "tones": { "ok": "sky", "wait": "yellow", "off": "coral", "live": "sky", "cap": "coral", "charging": "grass" }
  },
  "ring": {
    "inner": 164,
    "coreIn": 164,
    "coreOut": 180,
    "outer": 180,
    "speakMinWidth": 8,
    "speakMaxWidth": 22
  },
  "chips": {
    "rowX": 80, "rowW": 200, "rowY": 294, "rowH": 18, "row1Dy": 22, "stripH": 40,
    "avail": [196, 160], "gap": 6, "radius": 9,
    "bg": "chipStrip", "bgHot": "yellow", "overlayMs": 1500, "pageMs": 1500, "shownMs": 3000
  },
  "states": {
    "boot": { "icons": ["wifi:wait", "cloud:off", "volume:ok", "battery:ok"], "caption": "Bob", "ring": "soft" },
    "connecting": { "icons": ["wifi:wait", "cloud:wait", "volume:ok", "battery:ok"], "caption": "Connecting", "ring": "soft" },
    "pairing": { "icons": ["wifi:ok", "cloud:wait", "volume:ok", "battery:ok"], "caption": "", "ring": "ok", "bob": { "scale": 0.68, "rise": -90 } },
    "ready": { "icons": ["mic:live", "wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "Hi, I'm Bob", "ring": "soft" },
    "listening": { "icons": ["mic:cap", "wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "Listening", "ring": "listen" },
    "thinking": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "", "ring": "think" },
    "speaking": { "icons": ["wifi:ok", "cloud:ok", "volume:live", "battery:ok"], "caption": "", "ring": "speak", "bob": { "scale": 0.56, "rise": -133 } },
    "reply": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "", "ring": "soft", "bob": { "scale": 0.56, "rise": -133 } },
    "announce": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "Timer done", "ring": "notify" },
    "offline": { "icons": ["wifi:off", "cloud:off", "volume:ok", "battery:ok"], "caption": "Offline", "ring": "soft" },
    "error": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "Oops", "captionTone": "coral", "ring": "error" },
    "updating": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:wait"], "caption": "Updating", "ring": "think" },
    "dnd": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok", "moon:wait"], "caption": "", "ring": "dnd", "dim": 0.45 },
    "field": { "icons": ["wifi:ok", "cloud:ok", "volume:ok", "battery:ok"], "caption": "", "ring": "soft" }
  },
  "feedback": { "replyPageMs": 4200, "troubleMs": 4000 },
  "reply": { "textTop": 174, "textHeight": 76, "textInset": 58, "dotsY": 262, "dotSize": 6, "dotGap": 6, "lines": 3 },
  "motion": {
    "ease": [0.45, 0, 0.55, 1],
    "gestureMs": 650,
    "settleMs": 450,
    "fadeMs": 250,
    "spring": { "freq": 2.2, "damping": 5.5 },
    "lagMs": [60, 120],
    "ringMs": { "listen": 1600, "think": 1100, "pulse": 1200, "pulseSoft": 1200, "ok": 1600, "dnd": 4000, "speakFade": 90 },
    "linkPulseMs": 250,
    "pivot": [0.5, 0.9]
  }
}
