node_modules/
dist/
coverage/
.vite/
.env
# Filled per-platform env files. Only the .example templates are committed
# (docs/deploy.md); .env.braintrust is ignored further down.
.env.github
.env.supabase
apps/cardputer/include/secrets.h
apps/cardputer/**/.pio/
apps/ui-v2/public/vad/
*.db
*.db-journal
.DS_Store
*.log
npm-debug.log*
*.tsbuildinfo
*.mp3
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
data/
# PlatformIO build output; keeps firmware builds from staging artifacts.
.pio/
# Eval fixtures are synthetic and must live in the repo; the blanket data/
# rule above would hide them.
!apps/ai/evals/data/
!apps/ai/evals/data/*.json
certs/
.vscode/
.history/*
.specstory/*
openspec/

# Agent configuration is shared, not machine-local: a fresh clone needs the
# agents, skills and hooks. Only genuinely per-machine files stay ignored.
.claude/*
!.claude/agents/
!.claude/commands/
# The project's own skills are tracked; other skill folders are per-machine
# installs (restored from skills-lock.json) and stay ignored unless force-added.
!.claude/skills/
.claude/skills/*
!.claude/skills/bob-*/
!.claude/skills/dry-run-gate/
!.claude/skills/runpod-tts-batch/
# The SessionStart hook and the settings.json that registers it are shared;
# settings.local.json stays per-machine.
!.claude/hooks/
!.claude/settings.json
# The domain-agent manifest that .claude/agents/bob-<domain>.md are generated from.
!.claude/domains.json

# Other agent runtimes' local state.
.agents/
.opencode/
.specify/
.omo/
.flywheel/

# Added by Braintrust Wizard
.env.braintrust
.braintrust.json
# Email preview gallery (supabase/functions/_shared/email/preview.ts)
.email-preview/

# deno test/check writes a lockfile at the repo root; the functions pin versions in their imports
deno.lock
# Agent eval runs (npm run eval:agents); the task files under evals/agents/tasks are tracked.
evals/agents/results/
# Python bytecode (scripts/hil/serial-bridge.py runs under py -3.11).
__pycache__/
*.pyc
# Bob rig device blobs: generated by bob_rig_build.py --device-blobs on the firmware branch, never committed from the art branch
apps/cardputer/lib/bob_art/rig/*.rgb565a8
tools/bob-sim/.visor-check/
apps/cardputer/host_test.done
