# Supabase Edge Function secrets for a hosted project, plus the values
# `supabase config push` reads through env(...) in supabase/config.toml.
# scripts/env-files.test.ts pins the names against the function sources and
# config.toml.
#
# Apply:  cp .env.supabase.example .env.supabase   (git-ignored), fill it in, then
#   supabase secrets set --env-file .env.supabase --project-ref <ref>
# config push reads BOB_SMTP_USERNAME, BOB_SMTP_PASSWORD, BOB_SMTP_FROM and
# SEND_EMAIL_HOOK_SECRET from the shell environment, so export them first:
#   set -a; . ./.env.supabase; set +a; supabase config push --project-ref <ref>
#
# Fill every line or delete it. An empty value is stored as empty: a function
# then treats a required secret as missing. Quote a value that has spaces or <>.
#
# Values that must match the API server's environment (same bytes):
#   NOTIFY_EMAIL_SECRET == BOB_NOTIFY_EMAIL_SECRET (the API sends it as the
#     bearer notify-email and invite-account check).
#
# Do not set: Supabase injects these into every function itself.
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Send Email Hook signing secret. Generate: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_EMAIL_HOOK_SECRET=
# Bearer shared by the API and the notify-email function. Generate: openssl rand -hex 32
NOTIFY_EMAIL_SECRET=
# Pepper for the waitlist code hashes; changing it invalidates pending codes.
# Generate: openssl rand -hex 32
WAITLIST_CODE_PEPPER=
# Optional admin mailbox for waitlist signup alerts; omit to disable alerts.
WAITLIST_NOTIFY_EMAIL=

# Optional function settings. Each shows the default the code uses when the
# name is unset; uncomment a line only to override it.
# SMTP server for the Bob mailbox; unset means the function's built-in default host.
# BOB_SMTP_HOST=
# SMTP port; unset means 465 (implicit TLS), any other port uses STARTTLS.
# BOB_SMTP_PORT=
# Standing BCC copy of every outgoing email; empty means none.
# AUTH_EMAIL_BCC=
# Origin the waitlist function answers cross-origin (CORS) requests from.
# Additional exact origin; the heybob.xyz origins are always allowed.
# WAITLIST_ALLOWED_ORIGIN=


# Bob mailbox: the one SMTP mailbox every function and Supabase Auth
# ([auth.email.smtp] in config.toml) send through, shown as "Bob".
BOB_SMTP_USERNAME=
# Password or app password for the Bob mailbox.
BOB_SMTP_PASSWORD=
# Bob sender address; the functions fall back to BOB_SMTP_USERNAME, but config.toml
# uses it as Supabase Auth's admin_email, so set it.
BOB_SMTP_FROM=
