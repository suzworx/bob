# Copy to .env (git-ignored) and fill in what you need. `npm run dev:offline` needs only AI_GATEWAY_API_KEY
# (or none at all with --stub-ai).
PORT=7331
LOG_LEVEL=info

# The single provider credential for the server voice POC (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
# #1041: dev, test and production each have their own key. Set this to the
# PRODUCTION key's fingerprint (the first 8 hex characters of its SHA-256,
# non-secret) and live/test runs (test:live, test:scenarios, evals, pack and
# probe scripts) plus any non-production server refuse that key. Compute one
# without printing the key:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.env.AI_GATEWAY_API_KEY).digest('hex').slice(0,8))"
# BOB_PROD_KEY_FINGERPRINT=
# A deliberate production-key run only; leave unset.
# BOB_ALLOW_PROD_KEY=
# Production only: the DEV key's fingerprint, so a
# production server refuses to boot on it.
# BOB_DEV_KEY_FINGERPRINT=
# Chat model. Recommended: google/gemini-2.5-flash (bake-off #445, isEnglish
# read #446, live scenarios #453; docs/perf/chat-model-switch.md). Switching
# it also needs the extraction pin below, which would otherwise follow the chat
# model. Rollback: set BOB_CHAT_MODEL=openai/gpt-4o (the code default).
# BOB_CHAT_MODEL=google/gemini-2.5-flash
# BOB_MEMORY_EXTRACT_MODEL=openai/gpt-4o
# Model pins. The active values below equal the code defaults; change them to
# steer a deployment without touching code.
BOB_CHAT_MODEL=openai/gpt-4o
BOB_STT_MODEL=fish-audio/transcribe-1
# ISO-639-1 language pinned for speech-to-text. Unpinned, the provider
# auto-detects and short noisy mic input is misdetected often enough that
# replies come back in the wrong language. Set to 'auto' to auto-detect.
BOB_STT_LANGUAGE=en
# #1331: 1 = transcribe device speech while the user talks (stream opened at turn_start, final awaited
# 1.5 s after turn_end); any error, deadline, empty or not-ready stream falls back to BOB_STT_MODEL
# on the buffered audio. Default off; unset keeps the batch-only path.
BOB_STT_STREAMING=
# Streaming model used when BOB_STT_STREAMING=1 (code default shown). Takes raw PCM16 16 kHz mono.
BOB_STT_STREAMING_MODEL=microsoft/mai-transcribe-2-streaming
# #1331: 1 = skip the per-frame uplink `ack` (the firmware never reads it) and the per-frame
# v2.audio_up journal line; per-turn totals on v2.turn_ended stay. Default off; unset keeps both.
BOB_LEAN_UPLINK=
# #898: microsoft/mai-voice-2.1-flash/en-US-Harper beat openai/tts-1 in the live bake-off (0 errors vs 5.6% 30s+ hangs).
BOB_TTS_MODEL=microsoft/mai-voice-2.1-flash
BOB_TTS_VOICE=en-US-Harper
# Voice for a device whose assistant name is Bob (the owner chose this humble MAI US male voice). Bob or no name uses BOB_TTS_VOICE.
# Must be a MAI-Voice-2.1 en-US id (Ethan, Grant, Jasper, Sage, Harper, Iris, Olivia): anything else is refused at boot (v2.tts_voice_bob_error) and en-US-Sage kept.
BOB_TTS_VOICE_BOB=en-US-Sage
# on = cache short (<=200 char) TTS results in memory (128 entries, 1 h): the empty-turn reply, reminders fanned out to several devices. Default off.
BOB_TTS_CACHE=
# on = cache memory-query embeddings in memory (256 entries, 1 h): a repeated question skips the embed round trip. Default off.
BOB_EMBED_CACHE=
# cache-v1 layout only. on = explicit Anthropic cache breakpoints (instructions + last history message); needed only when BOB_CHAT_MODEL is anthropic/*. Default off.
BOB_PROVIDER_CACHE=
# Comma-separated Gateway provider order (e.g. vertex), sent as providerOptions.gateway.order. Gemini's implicit cache only hits on one backend, so pin it; failover is kept. Measure the journal `provider` field first. Default unset.
BOB_GATEWAY_ORDER=
# Versioned price snapshot for provider cost estimates (docs/observability.md "Usage and cost"): JSON with version, pricingDate, currency and per provider/model/unit rates. Empty = nothing priced (every call cost status unknown, never 0). Default unset.
BOB_COST_RATES=
# Speech assets (docs/speech-assets.md): a reviewed pack directory, or the public Supabase Storage folder of a hosted pack (fetched once at boot into a temp dir; printed by apps/api/scripts/upload-speech-pack.ts), and its build id. DIR wins over URL. Unset = ordinary TTS. Never mount a volume for it (it ends zero-downtime deploys and /data is the journal).
BOB_SPEECH_ASSETS_DIR=
BOB_SPEECH_ASSETS_URL=
BOB_SPEECH_ASSETS_BUILD=

# Optional production integrations.
# Set BOB_PRODUCTION=1 when exposing the API to the public internet (e.g.
# behind a Cloudflare Tunnel). In production the server refuses to start if
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY or BOB_DATABASE_URL is missing
# (DEVICE_SHARED_SECRET is required only when BOB_LEGACY_DEVICE_OWNER is
# set), always mounts /api behind the bearer JWT guard (even on a loopback
# bind), and enforces the same rate limits as a development deployment.
# Code default: unset (empty below is intentional — never ship =1 in a template).
BOB_PRODUCTION=
# BOB_CLIENT_IP_HEADER: header name whose first comma-separated entry is
# used as the rate-limit key. Set to your proxy's client-IP header to keep
# rate limits accurate behind it (e.g. x-real-ip).
# Leave empty to trust no header and always use the socket address (code default). No header
# is ever trusted implicitly.
BOB_CLIENT_IP_HEADER=
# BOB_CORS_ORIGINS: comma-separated list of origins allowed cross-origin
# access to /api/*. Empty or unset (default) means no cross-origin access
# (ui-v2 is same-origin, Vite dev proxies /api, Capacitor loads from
# app.heybob.xyz). Set this only if a separately-hosted client needs /api/* access.
# BOB_CORS_ORIGINS=https://app.example.com,https://other.example.com
BOB_WS_HEARTBEAT_MS=30000   # WebSocket ping interval in ms (code default); a device with no pong
                              # or message in this window is terminated to free
                              # its concurrency slot (positive int).
# DEVICE_SHARED_SECRET: shared secret the Cardputer sends as
# `Authorization: Bearer <secret>` on the /v2/cardputer WebSocket upgrade.
# When set, upgrades without a matching token are rejected with HTTP 401
# before any session is created. Leave unset for key-free development.
DEVICE_SHARED_SECRET=
METRICS_TOKEN=
# Telemetry backend: chosen only by the standard OTEL_* variables, never by code.
# Point it at any OTLP collector, for example a local one on :4318:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=bob
# OTEL_TRACES_EXPORTER=none switches trace export off even with an endpoint set.
# OTEL_METRICS_EXPORTER=none
# Auth headers for a backend that needs them (a secret; never commit a value):
# OTEL_EXPORTER_OTLP_HEADERS=
# Optional second destination for the same scrubbed spans (e.g. any vendor's
# OTLP traces URL and auth header). The header is a secret.
# BOB_OTLP_EXTRA_TRACES_ENDPOINT=
# BOB_OTLP_EXTRA_TRACES_HEADERS=
# The same for the journal's logs: a full OTLP logs URL and its auth header (a secret). Unset = off.
# Works without OTEL_LOGS_EXPORTER; the standard log variables still drive the primary.
# BOB_OTLP_EXTRA_LOGS_ENDPOINT=
# BOB_OTLP_EXTRA_LOGS_HEADERS=
# The same for the OTel metrics: a full OTLP metrics URL and its auth header (a secret). Unset = off.
# Independent of OTEL_METRICS_EXPORTER, which still drives the primary; OTEL_METRIC_EXPORT_INTERVAL applies to both.
# BOB_OTLP_EXTRA_METRICS_ENDPOINT=
# BOB_OTLP_EXTRA_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Supabase (accounts, pairing, follow-me). The server reads only
# BOB_DATABASE_URL; SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY serve the browser
# client and the local JWKS verifier, SUPABASE_DB_PASSWORD is for db push only.
# No code defaults: required in production (server refuses to start without
# them); empty here as placeholders to fill in.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
# SUPABASE_DB_PASSWORD=<your-db-password>
# BOB_DATABASE_URL is required in every mode: the server refuses to boot
# without it (there is no stand-in database). For development it is the local
# Supabase stack (`npm run dev:offline` sets it for you; the password lives in
# data/offline.env); in production the hosted session pooler.
# BOB_DATABASE_URL=postgresql://bob_server:<password>@127.0.0.1:54322/postgres
# BOB_DATABASE_URL=postgresql://bob_server.<project-ref>:<your-password>@<host>:5432/postgres
# BOB_LEGACY_DEVICE_OWNER=<your-account-uuid>

# App email (apps/api/src/core/email-client.ts). The API sends notification and
# space mail through the notify-email Supabase function; with the URL or the
# secret unset every send is skipped (journaled v2.email_skipped), so local dev
# mails nobody. The secret must equal the function's NOTIFY_EMAIL_SECRET.
# BOB_APP_URL builds the links inside emails (code default https://app.heybob.xyz).
BOB_APP_URL=https://app.heybob.xyz
# BOB_NOTIFY_EMAIL_URL=https://<project-ref>.supabase.co/functions/v1/notify-email
# BOB_NOTIFY_EMAIL_SECRET=<shared-secret>
# BOB_APP_URL=https://app.heybob.xyz
# A space invite to an address with no account first creates a confirmed one
# through the invite-account function (apps/api/src/core/account-provisioning.ts),
# with the same secret. Its URL is BOB_NOTIFY_EMAIL_URL with /notify-email
# swapped for /invite-account; set this only to point somewhere else.
# BOB_INVITE_ACCOUNT_URL=https://<project-ref>.supabase.co/functions/v1/invite-account

# OTA firmware (apps/api/src/firmware, docs/cardputer/ota-server.md).
# BOB_FW_PUBKEYS is a JSON object of key id to PEM public key, used to verify a
# release before it is ingested. These are PUBLIC keys: the files live in the repo
# at apps/cardputer/keys/*.pub.pem. Unset, no release can be ingested.
# POST /api/operator/firmware/ingest {"tag":"vX.Y.Z"} fetches the bundle from
# BOB_FW_GITHUB_REPO (default suzworx/Bob); the token is optional and only
# lifts GitHub's anonymous rate limit.
# BOB_FW_PUBKEYS={"fw-2026a":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
# BOB_FW_GITHUB_REPO=suzworx/Bob
# BOB_FW_GITHUB_TOKEN=<github-token>

# In-memory rate limits (per client IP; token bucket, no dependency).
# Shown values are the code defaults.
BOB_RATE_LIMIT_API_RPM=120        # max /api/* requests per minute -> 429
BOB_RATE_LIMIT_DEVICE_RPM=20      # max /v2/cardputer upgrades per minute -> 429
BOB_MAX_DEVICE_SESSIONS=3         # max concurrent device sessions total -> 503

# Cap on characters sent to TTS. Synthesis time scales with input length, and
# an uncapped reply can exceed the timeout and fail the turn with no audio.
# Shown values are the code defaults.
BOB_MAX_TTS_CHARS=700
# #898: 8000 matches the MAI voice's measured latency (p50 ~0.75s first-sentence).
BOB_TTS_TIMEOUT_MS=8000
# #1331: one deadline for a transcription, backup request included.
BOB_STT_TIMEOUT_MS=8000
# #1331: if BOB_STT_MODEL has not answered after BOB_STT_HEDGE_MS, the same
# audio also goes to BOB_STT_BACKUP_MODEL and the first success wins; the other
# request is aborted. 0 turns the backup off; a backup equal to the STT model never fires.
BOB_STT_HEDGE_MS=2500
BOB_STT_BACKUP_MODEL=openai/gpt-4o-mini-transcribe

# Cross-session memory. Extraction and retrieval run off the voice
# path; a failure or timeout never delays or fails the reply (FR-002, FR-008).
BOB_MEMORY_EXTRACT_MODEL=        # memory extraction model; empty follows BOB_CHAT_MODEL (code default)
BOB_MEMORY_PREFILTER_ENFORCE=1   # 1 (code default): a greeting/thanks/control turn skips the per-turn memory search and extraction; 0 reverts to journaling the verdict only
BOB_MEMORY_GATE=off              # code default; shadow scores each turn with an evaluation model and journals gate_score; on also skips extraction below 0.2. Sends the turn text to that model (no zero-data-retention guarantee), so it is opt-in
BOB_MEMORY_GATE_MODEL=typesafe-ai/jev    # the gate's evaluation model (code default)
BOB_MEMORY_RETRIEVAL_TIMEOUT_MS=2500      # hard retrieval timeout in ms (code default) -- a ceiling, not a target: typical retrieval is 380-750 ms; 2500 leaves headroom above T001's measured embed p95 (1162 ms) after a live run hit degraded:true 12 ms over the old 1200 ms budget; an embed timeout degrades to full-text+recency (FR-008)

# Browser client access and audio limits (2097152 is the code default).
# /api/* is always mounted behind the bearer JWT guard; BOB_SYSTEM_TEST=1
# on a loopback bind additionally exposes POST /api/test-token (web-auth.md).
BOB_WEB_AUDIO_MAX_BYTES=2097152

# Key-free run: stubs the agent, STT and TTS so no provider is contacted.
# Usually set inline (BOB_SYSTEM_TEST=1 npm run dev) rather than here.
# Requires a local database: a loopback BOB_DATABASE_URL, else no boot.
# Empty (code default): real provider path.
BOB_SYSTEM_TEST=
# Optional transcript returned by POST /api/voice while BOB_SYSTEM_TEST=1.
# Empty (code default): the stub transcript.
BOB_SYSTEM_TEST_TRANSCRIPT=
# AI-stub mode: "1" runs exactly the AI stubs (canned transcript, test-tone
# TTS, "System test response" replies) WITHOUT the test sign-in. Unlike
# BOB_SYSTEM_TEST=1 it changes no auth behaviour at all. Empty (code default).
BOB_AI_STUB=
# Dev user email for `npm run dev:offline` only (code default dev@bob.local).
BOB_DEV_EMAIL=dev@bob.local

# API listen address and logs (shown values are the code defaults). BOB_V2_HOST also decides the /api/* mounting
# rule above, so keep it loopback if you run without a token. Use a non-default
# BOB_V2_PORT for validation runs that must not disturb another local server.
BOB_V2_HOST=0.0.0.0
BOB_V2_PORT=7444
BOB_V2_JOURNAL=data/v2-journal.log
BOB_DEBUG_LOG=data/v2-debug.log
# Size cap per journal/debug/mirrored log file before rotation, and how many
# rotated generations are kept (code defaults: 8388608 bytes, 3 generations).
BOB_LOG_MAX_BYTES=8388608
BOB_LOG_KEEP=3

# Ports the browser client BINDS (example values, not code defaults — the dev
# server default is 5173). These are not the ports anyone types:
# http://bob.local/ must keep working with no suffix, so only lower these
# behind a kernel redirect (pf on macOS, iptables on Linux) that leaves the
# public ports at 80 and 443. Ports below 1024 are privileged on macOS and
# Linux; npm run dev:ui explains the remedy if the bind is refused.
# BOB_WEB_PORT=8443
# BOB_HTTP_PORT=8080

# Optional address announced by npm run mdns. Leave unset to auto-detect the
# first non-internal IPv4 address.
# BOB_MDNS_IP=192.168.1.10

# Verbose debug logging (npm run dev:debug sets this). The debug log contains
# transcripts and agent replies; it is git-ignored and must not be shared.
# Empty (code default): debug channels off.
BOB_DEBUG=
BOB_DEBUG_PAYLOAD=
BOB_DEBUG_FRAMES=

# Trace content. Spans are metadata-only by default: prompts, replies, and tool
# payloads never leave the machine unless BOB_TRACE_PAYLOAD=1 is set; they then
# go to every configured OTLP backend, production included, so set it locally
# only. Code default: unset.
# BOB_TRACE_PAYLOAD=1
# Browser Real User Monitoring (docs/observability.md). All three set turns it on; any unset
# leaves it off. The token is public and ingest-only (it ships to browsers by design).
# BOB_RUM_CLIENT_TOKEN=
# BOB_RUM_SITE=   # e.g. rum.example.com
# BOB_RUM_ORG=    # e.g. default
# BOB_EVAL_JUDGE_MODEL=   # empty follows BOB_CHAT_MODEL (code default).

# Evals (`npm run eval:*`). The suites in apps/ai/evals call the real agent
# through the AI Gateway, so they need AI_GATEWAY_API_KEY.
# Optional Google Workspace runtime. Configure all four together after migrations.
# The bridge is a separately deployed web endpoint (docs/google-connect.md).
# Generate a distinct random server-only bridge secret per environment.
BOB_GOOGLE_BRIDGE_URL=
BOB_GOOGLE_BRIDGE_SECRET=
BOB_GOOGLE_CLIENT_ID=
# Comma-separated exact HTTPS app callbacks; each must have a distinct trusted origin.
BOB_GOOGLE_CALLBACK_URLS=
# Optional exact HTTPS native return; must match bridge GOOGLE_CONNECT_NATIVE_CALLBACK_URL.
BOB_GOOGLE_NATIVE_CALLBACK_URL=

# Native iPhone remote notifications. Store actual values only in your deployment's secret store.
# All three credentials are required; absent credentials leave delivery unavailable.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
# Optional comma-separated bundle IDs allowed for installation registration.
APNS_TOPICS=xyz.heybob.ios
